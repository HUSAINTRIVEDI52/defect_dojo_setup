services:

  database:
    image: postgres:15-alpine
    container_name: defectdojo-db
    environment:
      POSTGRES_USER: ${DB_USER:-postgres}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-defectdojopassword}
      POSTGRES_DB: defectdojo
    volumes:
      - db_data:/var/lib/postgresql/data
    networks:
      - dojo-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    container_name: dojo-redis
    networks:
      - dojo-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Uses the dedicated initializer entrypoint that exists in the image
  initializer:
    image: defectdojo/defectdojo-django:latest
    container_name: dojo-initializer
    entrypoint: ["/entrypoint-initializer.sh"]
    environment:
      DD_DATABASE_ENGINE: django.db.backends.postgresql
      DD_DATABASE_HOST: database
      DD_DATABASE_PORT: "5432"
      DD_DATABASE_NAME: defectdojo
      DD_DATABASE_USER: ${DB_USER:-postgres}
      DD_DATABASE_PASSWORD: ${DB_PASSWORD:-defectdojopassword}
      DD_SECRET_KEY: ${DD_SECRET_KEY:-verySecretKey1234567890abcdefghijklmnopq}
      DD_ALLOWED_HOSTS: "*"
      DD_INITIALIZE: "true"
      DD_ADMIN_USER: admin
      DD_ADMIN_PASSWORD: ${DD_ADMIN_PASSWORD:-defectdojo}
      DD_ADMIN_FIRST_NAME: Admin
      DD_ADMIN_LAST_NAME: User
      DD_ADMIN_MAIL: admin@defectdojo.local
      DD_CELERY_BROKER_URL: redis://redis:6379/0
      CELERY_BROKER_URL: redis://redis:6379/0
      DD_SESSION_COOKIE_SECURE: "False"
      DD_CSRF_COOKIE_SECURE: "False"
    depends_on:
      database:
        condition: service_healthy
      redis:
        condition: service_healthy
    volumes:
      - dojo_media:/app/media
      - dojo_static:/app/static
    networks:
      - dojo-network

  # Uses DD_UWSGI_MODE=http + DD_UWSGI_ENDPOINT to serve HTTP directly
  uwsgi:
    image: defectdojo/defectdojo-django:latest
    container_name: dojo-uwsgi
    entrypoint: ["/entrypoint-uwsgi.sh"]
    environment:
      DD_DATABASE_ENGINE: django.db.backends.postgresql
      DD_DATABASE_HOST: database
      DD_DATABASE_PORT: "5432"
      DD_DATABASE_NAME: defectdojo
      DD_DATABASE_USER: ${DB_USER:-postgres}
      DD_DATABASE_PASSWORD: ${DB_PASSWORD:-defectdojopassword}
      DD_SECRET_KEY: ${DD_SECRET_KEY:-verySecretKey1234567890abcdefghijklmnopq}
      DD_ALLOWED_HOSTS: "*"
      DD_CELERY_BROKER_URL: redis://redis:6379/0
      CELERY_BROKER_URL: redis://redis:6379/0
      DD_SESSION_COOKIE_SECURE: "False"
      DD_CSRF_COOKIE_SECURE: "False"
      # These two vars make uwsgi serve plain HTTP on the configured port
      DD_UWSGI_MODE: http
      DD_UWSGI_ENDPOINT: "0.0.0.0:${DD_PORT:-8080}"
      DD_UWSGI_NUM_OF_PROCESSES: "2"
      DD_UWSGI_NUM_OF_THREADS: "2"
      # Additional performance tuning
      DD_UWSGI_BUFFER_SIZE: "8192"
    ports:
      - "${DD_PORT:-8080}:${DD_PORT:-8080}"
    volumes:
      - dojo_media:/app/media
      - dojo_static:/app/static
    networks:
      - dojo-network
    depends_on:
      database:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:${DD_PORT:-8080}/login?next=/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s

  celery_worker:
    image: defectdojo/defectdojo-django:latest
    container_name: dojo-celery-worker
    entrypoint: ["/entrypoint-celery-worker.sh"]
    environment:
      DD_DATABASE_ENGINE: django.db.backends.postgresql
      DD_DATABASE_HOST: database
      DD_DATABASE_PORT: "5432"
      DD_DATABASE_NAME: defectdojo
      DD_DATABASE_USER: ${DB_USER:-postgres}
      DD_DATABASE_PASSWORD: ${DB_PASSWORD:-defectdojopassword}
      DD_SECRET_KEY: ${DD_SECRET_KEY:-verySecretKey1234567890abcdefghijklmnopq}
      DD_ALLOWED_HOSTS: "*"
      DD_CELERY_BROKER_URL: redis://redis:6379/0
      CELERY_BROKER_URL: redis://redis:6379/0
      DD_CELERY_LOG_LEVEL: INFO
      DD_CELERY_WORKER_POOL_TYPE: solo
    volumes:
      - dojo_media:/app/media
    networks:
      - dojo-network
    depends_on:
      database:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: unless-stopped

  celery_beat:
    image: defectdojo/defectdojo-django:latest
    container_name: dojo-celery-beat
    entrypoint: ["/entrypoint-celery-beat.sh"]
    environment:
      DD_DATABASE_ENGINE: django.db.backends.postgresql
      DD_DATABASE_HOST: database
      DD_DATABASE_PORT: "5432"
      DD_DATABASE_NAME: defectdojo
      DD_DATABASE_USER: ${DB_USER:-postgres}
      DD_DATABASE_PASSWORD: ${DB_PASSWORD:-defectdojopassword}
      DD_SECRET_KEY: ${DD_SECRET_KEY:-verySecretKey1234567890abcdefghijklmnopq}
      DD_ALLOWED_HOSTS: "*"
      DD_CELERY_BROKER_URL: redis://redis:6379/0
      CELERY_BROKER_URL: redis://redis:6379/0
    networks:
      - dojo-network
    depends_on:
      database:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: unless-stopped

networks:
  dojo-network:
    name: defectdojo-net
    driver: bridge

volumes:
  db_data:
    name: defectdojo_db_data
  dojo_media:
    name: defectdojo_media
  dojo_static:
    name: defectdojo_static